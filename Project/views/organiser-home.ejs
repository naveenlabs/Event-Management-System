<!DOCTYPE html>
<html lang="en">
<head>
  <!-- ─────────────── Meta & Title ─────────────── -->
  <meta charset="utf-8">
  <title>Organiser Home – Eventra</title>

  <!-- ─────────────── External Styles ──────────────── -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    rel="stylesheet"
  >
  <link
    href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css"
    rel="stylesheet"
  >

  <!-- ─────────────── Custom CSS ──────────────── -->
  <link rel="stylesheet" href="/organiser-home.css">
</head>

<body class="main-home-bg text-white d-flex flex-column min-vh-100">

  <!-- ─────────────────────────────
       Header / Navigation
  ───────────────────────────── -->
  <header
    class="main-header d-flex justify-content-between align-items-center px-5 py-3"
    data-aos="fade-down"
  >
    <div class="logo d-flex align-items-center">
      <img src="/images/logo.png" alt="Logo" height="70" class="me-2">
      <h3 class="mb-0">Eventra</h3>
    </div>
    <nav class="nav-links d-flex gap-4">
      <a href="/"                 class="nav-item">Home</a>
      <a href="/organiser"        class="nav-item">Organiser</a>
      <a href="/attendee"         class="nav-item">Attendee</a>
      <a href="#"                 class="nav-item">About Us</a>
      <a href="#"                 class="nav-item">Contact</a>
      <a href="/organiser-logout" class="nav-item">Logout</a>
    </nav>
  </header>

  <!-- ─────────────────────────────
       Main Content
  ───────────────────────────── -->
  <main class="container py-5 flex-grow-1">

    <!-- Title & Introduction -->
    <h1 class="text-center fw-bold mb-2" data-aos="fade-up">Organiser Home Page</h1>
    <hr class="opacity-25 mb-4" data-aos="fade-up" data-aos-delay="100">

    <div class="text-center mb-5" data-aos="fade-up" data-aos-delay="200">
      <h1 class="display-5 fw-bold"><%= siteName %></h1>
      <div class="lead mb-4"><%- siteDescription %></div>

      <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
        <a href="/organiser/settings" class="btn btn-outline-light px-4">Edit Site Settings</a>
        <a href="/organiser/new"      class="btn-gradient px-4">+ Create New Event</a>
      </div>
    </div>

    <% /* ───────────── Date Formatter ───────────── */ %>
    <% function formatDate(ts) {
         const iso = ts.includes(' ') ? ts.replace(' ', 'T') + 'Z' : ts;
         const d   = new Date(iso);
         return d.toLocaleString('en-GB', {
           timeZone: 'Asia/Singapore',
           day:      'numeric',
           month:    'long',
           year:     'numeric',
           hour:     'numeric',
           minute:   '2-digit',
           hour12:   true
         });
       }
    %>

    <!-- Published Events -->
    <section class="mb-5">
      <hr class="opacity-25 mb-4" data-aos="fade-up">
      <h2 class="text-center fw-bold mb-4" data-aos="fade-up" data-aos-delay="50">Published Events</h2>

      <% if (publishedEvents.length) { %>
        <div class="row g-4">
          <% publishedEvents.forEach(event => { %>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
              <div class="event-card h-100 d-flex flex-column">

                <!-- Event Header -->
                <h4 class="fw-bold"><%= event.title %></h4>
                <% if (event.description) { %>
                  <p class="text-white-50 mb-2"><%= event.description %></p>
                <% } %>

                <!-- Date Info -->
                <p class="small mb-2">
                  <strong>Start:</strong>     <%= formatDate(event.date) %><br>
                  <strong>End:</strong>       <%= event.end_date ? formatDate(event.end_date) : 'N/A' %><br>
                  <strong>Created:</strong>   <%= formatDate(event.created_at) %><br>
                  <strong>Published:</strong> <%= formatDate(event.published_at) %><br>
                  <strong>Last Edited:</strong><%= formatDate(event.updated_at || event.created_at) %>
                </p>
                <hr class="opacity-25">

                <!-- Event Details -->
                <p class="small mb-2">
                  <strong>Organiser Info:</strong> <%= event.organiser_info %><br>
                  <strong>Location:</strong>       <%= event.location %><br>
                  <strong>Category:</strong>       <%= event.category %><br>
                  <strong>Capacity:</strong>       <%= event.capacity %> people
                </p>

                <!-- Early-bird Info -->
                <% if (event.early_bird_count > 0) { %>
                  <p class="small mb-2">
                    <strong>🪂 Early Bird:</strong> <%= event.early_bird_count %> ($<%= event.early_bird_price %>)<br>
                    <strong>Window:</strong>        <%= formatDate(event.early_bird_start).split(',')[0] %> – 
                                                  <%= formatDate(event.early_bird_end).split(',')[0] %>
                  </p>
                <% } %>

                <!-- Standard & Concession Counts -->
                <% if (event.full_price_count || event.student_count || event.senior_count || event.child_count) { %>
                  <p class="small mb-2">
                    <% if (event.full_price_count) { %>
                      🎫 <strong>Full Price:</strong> <%= event.full_price_count %> ($<%= event.full_price_amount %>)<br>
                    <% } %>
                    <% if (event.student_count) { %>
                      👩‍🎓 <strong>Student:</strong>    <%= event.student_count %> ($<%= event.student_price %>)<br>
                    <% } %>
                    <% if (event.senior_count) { %>
                      🧓 <strong>Senior:</strong>     <%= event.senior_count %> ($<%= event.senior_price %>)<br>
                    <% } %>
                    <% if (event.child_count) { %>
                      🧒 <strong>Child:</strong>      <%= event.child_count %> ($<%= event.child_price %>)<br>
                    <% } %>
                  </p>
                <% } %>

                <!-- Custom Concessions -->
                <% if (event.customConcessions && event.customConcessions.length) { %>
                  <p class="small mb-2">
                    <strong>Other Tickets:</strong><br>
                    <% event.customConcessions.forEach(cc => { %>
                      • <%= cc.name %>: <%= cc.count %> ($<%= cc.price %>)<br>
                    <% }) %>
                  </p>
                <% } %>

                <!-- Promo Codes -->
                <% if (event.promoCodes && event.promoCodes.length) { %>
                  <p class="small mb-2">
                    <strong>Promo Codes:</strong><br>
                    <% event.promoCodes.forEach(pc => { %>
                      • <%= pc.code %> (
                        <%= pc.discount_type === 'percent'
                              ? pc.discount_amount + '% off'
                              : '$' + pc.discount_amount + ' off'
                        %> )
                      <% if (pc.usage_limit) { %> – limit <%= pc.usage_limit %><% } %>
                      <% if (pc.expires_at) { %> , expires <%= formatDate(pc.expires_at).split(',')[0] %><% } %><br>
                    <% }) %>
                  </p>
                <% } %>

                <!-- Rules & Settings -->
                <p class="small mb-2">
                  <strong>Rules:</strong>           <%= event.rules %><br>
                  <strong>Max Tickets/User:</strong> <%= event.max_per_user %><br>
                  <strong>Payment Methods:</strong>  <%= event.payment_methods || 'Not specified' %>
                </p>

                <!-- Action Buttons -->
                <div class="mt-auto d-flex flex-wrap gap-2 pt-2">
                  <a href="/attendee/event/<%= event.id %>"
                     class="btn btn-outline-light flex-grow-1 text-center">
                    View
                  </a>
                  <a href="/organiser/stats/<%= event.id %>"
                     class="btn-gradient flex-grow-1 text-center">
                    Dashboard
                  </a>
                  <form action="/organiser/delete/<%= event.id %>" method="POST" class="flex-grow-1">
                    <button type="submit" class="btn btn-outline-light w-100 text-center">
                      Delete
                    </button>
                  </form>
                </div>

              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-center">No published events yet.</p>
      <% } %>
    </section>

    <!-- Draft Events -->
    <section>
      <hr class="opacity-25 mt-5 mb-4" data-aos="fade-up">
      <h2 class="text-center fw-bold mb-4" data-aos="fade-up" data-aos-delay="50">Draft Events</h2>

      <% if (draftEvents.length) { %>
        <div class="row g-4">
          <% draftEvents.forEach(event => {
               if (event.title && event.title.trim()) {
          %>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
              <div class="event-card h-100 d-flex flex-column">

                <!-- Event Info -->
                <h4 class="fw-bold"><%= event.title %></h4>
                <% if (event.description) { %>
                  <p class="text-white-50 mb-2"><%= event.description %></p>
                <% } %>

                <p class="small mb-2">
                  <strong>Start:</strong>     <%= formatDate(event.date) %><br>
                  <strong>End:</strong>       <%= event.end_date ? formatDate(event.end_date) : 'N/A' %><br>
                  <strong>Created:</strong>   <%= formatDate(event.created_at) %><br>
                  <strong>Last Edited:</strong><%= formatDate(event.updated_at || event.created_at) %>
                </p>
                <hr class="opacity-25">

                <p class="small mb-2">
                  <strong>Organiser Info:</strong> <%= event.organiser_info %><br>
                  <strong>Location:</strong>       <%= event.location %><br>
                  <strong>Category:</strong>       <%= event.category %><br>
                  <strong>Capacity:</strong>       <%= event.capacity %> people
                </p>

                <% if (event.early_bird_count > 0) { %>
                  <p class="small mb-2">
                    <strong>🪂 Early Bird:</strong> <%= event.early_bird_count %> ($<%= event.early_bird_price %>)<br>
                    <strong>Window:</strong>        <%= formatDate(event.early_bird_start).split(',')[0] %> – 
                                                  <%= formatDate(event.early_bird_end).split(',')[0] %>
                  </p>
                <% } %>

                <% if (event.full_price_count || event.student_count || event.senior_count || event.child_count) { %>
                  <p class="small mb-2">
                    <% if (event.full_price_count) { %>
                      🎫 <strong>Full Price:</strong> <%= event.full_price_count %> ($<%= event.full_price_amount %>)<br>
                    <% } %>
                    <% if (event.student_count) { %>
                      👩‍🎓 <strong>Student:</strong>    <%= event.student_count %> ($<%= event.student_price %>)<br>
                    <% } %>
                    <% if (event.senior_count) { %>
                      🧓 <strong>Senior:</strong>     <%= event.senior_count %> ($<%= event.senior_price %>)<br>
                    <% } %>
                    <% if (event.child_count) { %>
                      🧒 <strong>Child:</strong>      <%= event.child_count %> ($<%= event.child_price %>)<br>
                    <% } %>
                  </p>
                <% } %>

                <% if (event.customConcessions && event.customConcessions.length) { %>
                  <p class="small mb-2">
                    <strong>Other Tickets:</strong><br>
                    <% event.customConcessions.forEach(cc => { %>
                      • <%= cc.name %>: <%= cc.count %> ($<%= cc.price %>)<br>
                    <% }) %>
                  </p>
                <% } %>

                <% if (event.promoCodes && event.promoCodes.length) { %>
                  <p class="small mb-2">
                    <strong>Promo Codes:</strong><br>
                    <% event.promoCodes.forEach(pc => { %>
                      • <%= pc.code %> (
                        <%= pc.discount_type === 'percent'
                              ? pc.discount_amount + '% off'
                              : '$' + pc.discount_amount + ' off'
                        %> )
                      <% if (pc.usage_limit) { %> – limit <%= pc.usage_limit %><% } %>
                      <% if (pc.expires_at) { %> , expires <%= formatDate(pc.expires_at).split(',')[0] %><% } %><br>
                    <% }) %>
                  </p>
                <% } %>

                <p class="small mb-2">
                  <strong>Rules:</strong>           <%= event.rules %><br>
                  <strong>Max Tickets/User:</strong> <%= event.max_per_user %><br>
                  <strong>Payment Methods:</strong>  <%= event.payment_methods || 'Not specified' %>
                </p>

                <!-- Draft Actions -->
                <div class="mt-auto d-flex flex-wrap gap-2 pt-2">
                  <a href="/organiser/edit/<%= event.id %>"
                     class="btn btn-outline-light flex-grow-1 text-center">
                    Edit
                  </a>
                  <form action="/organiser/publish/<%= event.id %>" method="POST" class="flex-grow-1">
                    <button type="submit" class="btn-gradient w-100 text-center">
                      Publish
                    </button>
                  </form>
                  <form action="/organiser/delete/<%= event.id %>" method="POST" class="flex-grow-1">
                    <button type="submit" class="btn btn-outline-light w-100 text-center">
                      Delete
                    </button>
                  </form>
                </div>

              </div>
            </div>
          <% } }) %>
        </div>
      <% } else { %>
        <p class="text-center">No draft events yet.</p>
      <% } %>
    </section>

  </main>

  <!-- ─────────────────────────────
       Footer
  ───────────────────────────── -->
  <footer class="main-footer text-center mt-auto" data-aos="fade-up">
    <small>&copy; 2025 Eventra. All rights reserved.</small>
  </footer>

  <!-- ─────────────────────────────
       Scripts & AOS Init
  ───────────────────────────── -->
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script>
    AOS.init({
      duration: 800,
      once:     true
    });
  </script>
</body>
</html>
