<!DOCTYPE html>
<html lang="en">
<head>
  <!-- ─────────────── Meta & Title ─────────────── -->
  <meta charset="utf-8">
  <title>Eventra – Home</title>

  <!-- ─────────────── External Styles ──────────── -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <!-- ─────────────── Project Styles ───────────── -->
  <link rel="stylesheet" href="/main.css">

  <!-- ─────────────── Inline Keyframes ─────────── -->
  <style>
    @keyframes fadeUpAlt {
      0%   { opacity: 0; transform: translateY(45px) scale(.97); }
      60%  { opacity: 0.6; transform: translateY(-6px) scale(1.01); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    .fade-up-alt { opacity: 0; transform: translateY(45px) scale(.97); }
    .animate.fade-up-alt { animation: fadeUpAlt .8s cubic-bezier(.25,.8,.25,1) forwards; }
  </style>
</head>

<body class="main-home-bg text-white d-flex flex-column min-vh-100">

  <!-- ─────────────────────────────
       Header / Navbar
  ───────────────────────────── -->
  <header class="main-header d-flex justify-content-between align-items-center px-5 py-3 fade-up-alt">
    <div class="logo d-flex align-items-center">
      <img src="/images/logo.png" alt="Logo" height="70" class="me-2">
      <h3 class="mb-0">Eventra</h3>
    </div>
    <nav class="nav-links d-flex gap-4">
      <a href="/"          class="nav-item">Home</a>
      <a href="/organiser" class="nav-item">Organiser</a>
      <a href="/attendee"  class="nav-item">Attendee</a>
      <a href="#"          class="nav-item">About&nbsp;Us</a>
      <a href="#"          class="nav-item">Contact</a>
    </nav>
  </header>

  <!-- ─────────────────────────────
       Main Content
  ───────────────────────────── -->
  <main class="main-content flex-grow-1">

    <!-- Hero -->
    <section class="hero text-center d-flex flex-column justify-content-center align-items-center py-5 fade-up-alt">
      <h1 class="display-4 fw-bold">Your Gateway to Seamless Event Management</h1>
      <p class="lead mt-3 mb-4">Buy and manage tickets with ease — for both organisers and attendees</p>
      <div class="d-flex gap-4 flex-column flex-md-row w-100 px-3" style="max-width:600px">
        <a href="/organiser" class="btn btn-gradient btn-lg w-100">Organiser Portal</a>
        <a href="/attendee"  class="btn btn-outline-light btn-lg w-100">Attendee Portal</a>
      </div>
    </section>

    <!-- Live Stats -->
    <section class="live-stats text-center py-5 fade-up-alt">
      <div class="container">
        <div class="row g-4">
          <div class="col-md-4">
            <h3 class="fw-bold"><span class="counter" data-target="1200">0</span>+</h3>
            <p class="text-white-50">Events Created</p>
          </div>
          <div class="col-md-4">
            <h3 class="fw-bold"><span class="counter" data-target="85000">0</span>+</h3>
            <p class="text-white-50">Tickets Sold</p>
          </div>
          <div class="col-md-4">
            <h3 class="fw-bold">$<span class="counter" data-target="1200000">0</span>+</h3>
            <p class="text-white-50">Revenue Processed</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="how-it-works text-center py-5 fade-up-alt">
      <div class="container">
        <h2 class="mb-4 fw-bold">How It Works</h2>
        <div class="row g-4">
          <div class="col-md-4"><div class="p-4 how-box h-100">
            <div class="mb-3"><i class="bi bi-pencil-square display-5 text-info"></i></div>
            <h5 class="fw-bold">1. Create Your Event</h5>
            <p>Set up your event with ease and custom options.</p>
          </div></div>
          <div class="col-md-4"><div class="p-4 how-box h-100">
            <div class="mb-3"><i class="bi bi-ticket-perforated display-5 text-danger"></i></div>
            <h5 class="fw-bold">2. Customize Tickets</h5>
            <p>Add various ticket types, concessions, and promos.</p>
          </div></div>
          <div class="col-md-4"><div class="p-4 how-box h-100">
            <div class="mb-3"><i class="bi bi-bar-chart-line display-5 text-warning"></i></div>
            <h5 class="fw-bold">3. Powerful Dashboard</h5>
            <p>Monitor ticket sales, revenue, and guest data — all in one place.</p>
          </div></div>
        </div>
      </div>
    </section>

    <!-- Trust Badges -->
    <section class="trust-badges text-center py-5 fade-up-alt">
      <div class="container">
        <div class="row justify-content-center g-4">
          <div class="col-md-2"><i class="bi bi-shield-lock text-success display-6"></i><p class="mt-2">SSL Secure</p></div>
          <div class="col-md-2"><i class="bi bi-credit-card text-info display-6"></i><p class="mt-2">Trusted Payments</p></div>
          <div class="col-md-2"><i class="bi bi-x-circle text-danger display-6"></i><p class="mt-2">No Hidden Fees</p></div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="testimonials text-center py-5 fade-up-alt">
      <div class="container">
        <h2 class="mb-4 fw-bold">What People Are Saying</h2>
        <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
          <div class="carousel-inner">
            <div class="carousel-item active">
              <blockquote class="blockquote">
                <p>“Loved the smooth booking process. Super intuitive!”</p>
                <footer class="blockquote-footer text-white">Tanisha, Attendee</footer>
              </blockquote>
            </div>
            <div class="carousel-item">
              <blockquote class="blockquote">
                <p>“Creating my event was a breeze. Highly recommend!”</p>
                <footer class="blockquote-footer text-white">Rahul, Organiser</footer>
              </blockquote>
            </div>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
          </button>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section class="newsletter text-center py-5 fade-up-alt">
      <div class="container" style="max-width:600px">
        <h4 class="fw-bold">Stay Updated with Eventra</h4>
        <form class="d-flex flex-column flex-md-row gap-2 justify-content-center">
          <input type="email" class="form-control rounded-pill px-4" placeholder="Enter your email">
          <button type="submit" class="btn btn-gradient rounded-pill px-4">Subscribe</button>
        </form>
      </div>
    </section>

  </main>

  <!-- ─────────────────────────────
       Footer
  ───────────────────────────── -->
  <footer class="main-footer text-center mt-auto">
    <small>&copy; 2025 Eventra. All rights reserved.</small>
  </footer>

  <!-- ─────────────────────────────
       Scripts
  ───────────────────────────── -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      /* IntersectionObserver for fade-up-alt */
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('animate');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.fade-up-alt').forEach(el => io.observe(el));

      /* Animated counters */
      document.querySelectorAll('.counter').forEach(counter => {
        const target = +counter.dataset.target;
        let cur = 0;
        const step = Math.max(1, target / 200);
        const tick = () => {
          cur += step;
          if (cur < target) {
            counter.textContent = Math.ceil(cur).toLocaleString();
            requestAnimationFrame(tick);
          } else {
            counter.textContent = target.toLocaleString();
          }
        };
        tick();
      });
    });
  </script>
</body>
</html>
