<!DOCTYPE html>
<html lang="en">
<head>
  <!-- ─────────────── Meta & Title ─────────────── -->
  <meta charset="utf-8">
  <title>Site Settings – Eventra</title>

  <!-- ─────────────── External Styles & Scripts ──────────── -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
  <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

  <!-- ─────────────── Custom CSS ──────────────── -->
  <link rel="stylesheet" href="/organiser-site-settings.css">
</head>

<body class="main-home-bg text-white d-flex flex-column min-vh-100">

  <!-- ─────────────────────────────
       Header / Navigation
  ───────────────────────────── -->
  <header class="main-header d-flex justify-content-between align-items-center px-5 py-3">
    <div class="logo d-flex align-items-center fade-up">
      <img src="/images/logo.png" alt="Logo" height="70" class="me-2">
      <h3 class="mb-0">Eventra</h3>
    </div>
    <nav class="nav-links d-flex gap-4 fade-up">
      <a href="/" class="nav-item">Home</a>
      <a href="/organiser" class="nav-item">Organiser</a>
      <a href="/attendee" class="nav-item">Attendee</a>
      <a href="#" class="nav-item">About Us</a>
      <a href="#" class="nav-item">Contact</a>
    </nav>
  </header>

  <!-- ─────────────────────────────
       Main Content: Site Settings
  ───────────────────────────── -->
  <main class="container py-5 flex-grow-1">
    <h1 class="text-center mb-5 fw-bold display-5 fade-up">Site Settings</h1>

    <!-- Live Preview -->
    <div class="row justify-content-center mb-5 preview-section fade-up">
      <div class="col-lg-8">
        <div class="card text-white hover-card">
          <div class="card-body">
            <h2 class="fw-bold text-center mb-4">Live Preview</h2>
            <h3 id="previewName" class="fw-bold mb-2"><%= settings.name %></h3>
            <div id="previewDesc" class="text-white-50"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Settings Form -->
    <div class="row justify-content-center fade-up">
      <div class="col-lg-6">
        <form method="POST" action="/organiser/settings"
              onsubmit="return validateForm()"
              class="card form-card hover-card">

          <!-- Site Name -->
          <div class="mb-3">
            <label for="name" class="form-label fw-semibold">Site Name</label>
            <input id="name" name="name" maxlength="100"
                   value="<%= settings.name %>"
                   class="form-control bg-light text-dark"
                   oninput="updateCounter('name','nameCount',20,true); updatePreview();"
                   required>
            <div class="form-text text-white-50 text-end">
              <span id="nameCount">0</span>/20 words
            </div>
          </div>

          <!-- Site Description -->
          <div class="mb-3">
            <label for="editor" class="form-label fw-semibold">Site Description</label>
            <input type="hidden" name="description" id="descriptionHidden">
            <div id="editor"
                 class="bg-white rounded shadow-sm"
                 style="height: 160px;">
            </div>
            <div class="form-text text-white-50 text-end mt-1">
              <span id="descCount">0</span>/100 words
            </div>
          </div>

          <!-- Actions -->
          <div class="d-flex gap-3 mt-4 flex-wrap justify-content-center">
            <button type="submit" class="btn-gradient px-5 py-2 fs-5">Update Settings</button>
            <button type="button" class="btn btn-outline-light px-4 py-2 fs-5" onclick="resetForm()">Reset</button>
          </div>

          <!-- Last Updated Timestamp -->
          <% if (settings.updated_at) { %>
            <p class="mt-4 mb-0 text-white-50 small">
              Last Updated:
              <%= new Date(settings.updated_at).toLocaleString('en-GB', {
                weekday: 'short', day: 'numeric', month: 'long',
                year: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true
              }) %>
            </p>
          <% } %>

        </form>
      </div>
    </div>

    <!-- Back Link -->
    <p class="text-center mt-5 fade-up">
      <a href="/organiser" class="btn btn-outline-light btn-lg px-4 py-2">
        Back to Organiser Home Page
      </a>
    </p>
  </main>

  <!-- ─────────────────────────────
       Footer
  ───────────────────────────── -->
  <footer class="main-footer text-center mt-auto fade-up">
    <small>&copy; 2025 Eventra. All rights reserved.</small>
  </footer>

  <!-- ─────────────────────────────
       Scripts & Initialization
  ───────────────────────────── -->
  <script>
    /* IntersectionObserver for fade-up animations */
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.15 });

      document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    });

    /* Initialize Quill editor & live preview */
    const quill = new Quill('#editor', {
      theme: 'snow',
      placeholder: 'Enter site description...',
      modules: { toolbar: [['bold', 'italic', 'underline'], [{ list: 'bullet' }, { list: 'ordered' }]] }
    });
    quill.root.innerHTML = `<%- settings.description %>`;
    document.getElementById('previewDesc').innerHTML = quill.root.innerHTML;

    function countWords(text) {
      return (text.trim().match(/\b\w+\b/g) || []).length;
    }
    function updateCounter(inputId, countId, limit, isWords = false) {
      const val = document.getElementById(inputId).value;
      document.getElementById(countId).innerText = isWords ? countWords(val) : val.length;
    }
    function updatePreview() {
      document.getElementById('previewName').innerText =
        document.getElementById('name').value || '[Your Site Name]';
      document.getElementById('previewDesc').innerHTML = quill.root.innerHTML;
      document.getElementById('descCount').innerText = countWords(quill.getText());
    }
    function resetForm() {
      document.getElementById('name').value = '';
      quill.setText('');
      updateCounter('name', 'nameCount', 20, true);
      updatePreview();
    }
    function validateForm() {
      const name = document.getElementById('name').value.trim();
      if (countWords(name) > 20) {
        alert('Site name must not exceed 20 words.');
        return false;
      }
      if (!/^[A-Za-z\s]+$/.test(name)) {
        alert('Site name should contain only letters and spaces.');
        return false;
      }
      const descWords = countWords(quill.getText().trim());
      if (descWords === 0) {
        alert('Site description is required.');
        return false;
      }
      if (descWords > 100) {
        alert('Site description must not exceed 100 words.');
        return false;
      }
      document.getElementById('descriptionHidden').value = quill.root.innerHTML;
      return true;
    }

    /* Initial counters & preview on load */
    updateCounter('name', 'nameCount', 20, true);
    updatePreview();
    quill.on('text-change', updatePreview);
  </script>
</body>
</html>
