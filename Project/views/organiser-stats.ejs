<!DOCTYPE html>
<html lang="en">
<head>
  <!-- ─────────────── Meta & Title ─────────────── -->
  <meta charset="utf-8">
  <title>Event Stats – <%= event.title %></title>

  <!-- ─────────────── Stylesheets ──────────────── -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
  <link rel="stylesheet" href="/organiser-stats.css">
</head>

<body class="main-home-bg text-white d-flex flex-column min-vh-100">

  <!-- ─────────────────────────────
       Header / Navigation
  ───────────────────────────── -->
  <header
    class="main-header d-flex justify-content-between align-items-center px-5 py-3"
    data-aos="fade-down"
  >
    <div class="logo d-flex align-items-center">
      <img src="/images/logo.png" alt="Logo" height="70" class="me-2">
      <h3 class="mb-0">Eventra</h3>
    </div>
    <nav class="nav-links d-flex gap-4">
      <a href="/"                 class="nav-item">Home</a>
      <a href="/organiser"        class="nav-item">Organiser</a>
      <a href="/attendee"         class="nav-item">Attendee</a>
      <a href="#"                 class="nav-item">About Us</a>
      <a href="#"                 class="nav-item">Contact</a>
      <a href="/organiser-logout" class="nav-item">Logout</a>
    </nav>
  </header>

  <!-- ─────────────────────────────
       Main Content
  ───────────────────────────── -->
  <main class="container py-5 flex-grow-1">

    <!-- Dashboard Title & Back Link -->
    <h1 class="text-center fw-bold mb-4" data-aos="fade-up">
      Dashboard for “<%= event.title %>”
    </h1>
    <div class="text-center mb-4" data-aos="fade-up" data-aos-delay="50">
      <a href="/organiser" class="btn btn-outline-light px-4 py-2">
        <i class="bi bi-arrow-left me-2"></i>Back to Organiser Home
      </a>
    </div>

    <!-- Event Summary -->
    <div class="mb-5" data-aos="fade-up" data-aos-delay="100">
      <p><strong>Location:</strong> <%= event.location %></p>
      <p><strong>Organiser:</strong> <%= event.organiser_info %></p>
      <p><strong>Capacity (total seats):</strong> <%= event.capacity %></p>
      <p><strong>Seats Left:</strong> <%= seatsLeft %></p>
      <p><strong>Total Bookings:</strong> <%= totals.totalBookings %></p>
      <p><strong>Total Revenue:</strong> $<%= totals.totalRevenue.toFixed(2) %></p>
    </div>

    <!-- Ticket Breakdown -->
    <section class="stats-card" data-aos="fade-up" data-aos-delay="200">
      <h2 class="fw-bold mb-3">Ticket Breakdown</h2>
      <table class="stats-table">
        <thead>
          <tr>
            <th>Ticket Type</th>
            <th>Price</th>
            <th>Total</th>
            <th>Sold</th>
            <th>Left</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Full Price</td>
            <td>$<%= event.full_price_amount.toFixed(2) %></td>
            <td><%= capacities.full %></td>
            <td><%= totals.full %></td>
            <td><%= left.full %></td>
          </tr>
          <tr>
            <td>Student</td>
            <td>$<%= event.student_price.toFixed(2) %></td>
            <td><%= capacities.student %></td>
            <td><%= totals.student %></td>
            <td><%= left.student %></td>
          </tr>
          <tr>
            <td>Senior</td>
            <td>$<%= event.senior_price.toFixed(2) %></td>
            <td><%= capacities.senior %></td>
            <td><%= totals.senior %></td>
            <td><%= left.senior %></td>
          </tr>
          <tr>
            <td>Child</td>
            <td>$<%= event.child_price.toFixed(2) %></td>
            <td><%= capacities.child %></td>
            <td><%= totals.child %></td>
            <td><%= left.child %></td>
          </tr>
          <tr>
            <td>
              Early Bird<br>
              <small>(
                <%= new Date(event.early_bird_start).toLocaleString('en-GB', {
                     day:'numeric', month:'short', year:'numeric',
                     hour:'2-digit', minute:'2-digit', hour12:true
                }) %> –
                <%= new Date(event.early_bird_end).toLocaleString('en-GB', {
                     day:'numeric', month:'short', year:'numeric',
                     hour:'2-digit', minute:'2-digit', hour12:true
                }) %>
              )</small>
            </td>
            <td>$<%= event.early_bird_price.toFixed(2) %></td>
            <td><%= capacities.early %></td>
            <td><%= totals.early %></td>
            <td><%= left.early %></td>
          </tr>
          <% customConcs.forEach(cc => { %>
            <tr>
              <td><%= cc.name %> (custom)</td>
              <td>$<%= Number(cc.price).toFixed(2) %></td>
              <td><%= capacities['custom_' + cc.id] %></td>
              <td><%= totals.custom['custom_' + cc.id] || 0 %></td>
              <td><%= left['custom_' + cc.id] %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <!-- Promo Code Usage -->
    <section class="stats-card" data-aos="fade-up" data-aos-delay="300">
      <h2 class="fw-bold mb-3">Promo Code Usage</h2>
      <table class="stats-table promo-table">
        <thead>
          <tr>
            <th>Promo Code</th>
            <th>Description</th>
            <th>Limit</th>
            <th>Used</th>
            <th>Left</th>
            <th>Expires</th>
          </tr>
        </thead>
        <tbody>
          <% promoList.forEach(pc => { %>
            <tr>
              <td><%= pc.code %></td>
              <td>
                <% if (pc.discount_type === 'fixed') { %>
                  $<%= pc.discount_amount.toFixed(2) %> off Standard
                <% } else { %>
                  <%= pc.discount_amount %>% off Standard
                <% } %>
              </td>
              <td><%= pc.limit %></td>
              <td><%= pc.used %></td>
              <td><%= pc.left %></td>
              <td>
                <% if (pc.expires_at) { %>
                  <%= new Date(pc.expires_at).toLocaleString('en-GB', {
                       day:'numeric', month:'short', year:'numeric',
                       hour:'2-digit', minute:'2-digit', hour12:true
                  }) %>
                <% } else { %>—<% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <!-- All Bookings -->
    <section class="stats-card" data-aos="fade-up" data-aos-delay="400">
      <h2 class="fw-bold mb-3">All Bookings</h2>
      <div class="table-responsive">
        <table class="stats-table bookings-table">
          <thead>
            <tr>
              <th>Booking ID</th>
              <th>Contact</th>
              <th>Tickets &amp; Guests</th>
              <th>Promo Used</th>
              <th>Amount Paid</th>
              <th>Payment</th>
              <th>Booked At</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(b => {
                 const cd   = JSON.parse(b.concession_detail || '{}');
                 const paid = Number(b.total_paid || 0);
                 let names  = [], phones = [];
                 try {
                   names  = JSON.parse(b.guest_names);
                   phones = JSON.parse(b.guest_phones);
                 } catch {}
            %>
              <tr>
                <td>
                  <span class="booking-id-badge px-3 py-2"><%= b.id %></span>
                </td>
                <td>
                  👤 <strong><%= b.contact_name %></strong><br>
                  📧 <%= b.contact_email %><br>
                  📞 <%= b.contact_phone %>
                </td>
                <td>
                  Std: <%= b.full_price_tickets || 0 %><br>
                  Stud: <%= cd.student   || 0 %><br>
                  Sr:   <%= cd.senior    || 0 %><br>
                  Child:<%= cd.child     || 0 %><br>
                  EB:   <%= cd.early_bird|| 0 %><br>
                  <% customConcs.forEach(cc => {
                       const q = cd['custom_' + cc.id] || 0;
                       if (q) { %>
                    <%= cc.name %>: <%= q %><br>
                  <% }}); %>
                  <hr class="my-2 border-white border-opacity-25">
                  <div class="guest-list">
                    <% names.forEach((n,i) => { %>
                      <span>
                        👥 Guest <%= i+1 %>: <%= n %> (<%= phones[i] || '–' %>)
                      </span>
                    <% }); %>
                  </div>
                </td>
                <td><%= b.promo_code_id ? b.promo_code_used : '—' %></td>
                <td class="text-success fw-bold">$<%= paid.toFixed(2) %></td>
                <td>
                  💳 <%= b.payment?.method || '—' %><br>
                  <% if (b.payment?.transaction_id) { %>
                    🧾 <%= b.payment.transaction_id %>
                  <% } %>
                </td>
                <td><%= new Date(b.created_at).toLocaleString('en-GB') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

  </main>

  <!-- ─────────────────────────────
       Footer
  ───────────────────────────── -->
  <footer class="main-footer text-center mt-auto">
    <small>&copy; 2025 Eventra. All rights reserved.</small>
  </footer>

  <!-- ─────────────────────────────
       Scripts
  ───────────────────────────── -->
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script>AOS.init();</script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
